{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": { "@compartilhado/*": ["src/compartilhado/*"] }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/compartilhado/**/*.ts",
    "electron.vite.config.ts",
    "testes/entrada.test.ts",
    "testes/segredos.test.ts",
    "testes/validacao.test.ts"
  ]
}
