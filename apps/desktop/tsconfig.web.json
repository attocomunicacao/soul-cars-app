{
  // Tipos do lado da interface (React, DOM) e dos testes das regras de interface.
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/intake.test.ts",
    "tests/legacy-ai-cleanup.test.ts",
    "tests/validation.test.ts",
    "tests/bndv-graphql.test.ts",
    "tests/showcase.test.ts",
    "tests/bndv-extras.test.ts",
    "tests/report-print.test.ts",
    "tests/config-json.test.ts",
    "tests/models.test.ts",
    "tests/gpu.test.ts",
    "tests/repository.test.ts",
    "tests/utalk-api.test.ts",
    "tests/crm-tags.test.ts",
    "tests/soul-ai.test.ts",
    "tests/performance.test.ts"
  ]
}
