{
  "name": "soul-cars",
  "version": "1.0.0",
  "private": true,
  "description": "Soul Cars — plataforma de gestão para revendas de veículos: Launcher + app desktop + motor de automação",
  "author": "Atto Comunicação",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/launcher"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "dev:launcher": "npm run dev -w apps/launcher",
    "build": "npm run build -w apps/desktop && npm run build -w apps/launcher",
    "typecheck": "npm run typecheck -w apps/desktop && npm run typecheck -w apps/launcher",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w apps/desktop && npm run test -w apps/launcher",
    "test:engine": "cd apps/engine && uv run --all-groups python -m unittest discover -s tests -p \"test_*.py\"",
    "smoke": "npm run smoke -w apps/desktop",
    "smoke:instagram": "npm run smoke:instagram -w apps/desktop",
    "e2e:launcher": "npm run build -w apps/launcher && electron apps/launcher/scripts/e2e-install.cjs",
    "screenshots": "npm run build -w apps/desktop && npm run screenshots -w apps/desktop",
    "package:desktop": "npm run package -w apps/desktop",
    "package:launcher": "npm run package -w apps/launcher",
    "release:manifest": "node scripts/release/create-manifest.mjs",
    "format": "prettier --write \"apps/desktop/src/{main,preload,shared}/**/*.ts\" \"apps/desktop/src/renderer/src/**/*.{ts,tsx,css}\" \"apps/desktop/tests/**/*.{ts,mjs}\" \"apps/desktop/scripts/*.cjs\" \"apps/desktop/*.{ts,json}\" \"apps/launcher/src/**/*.{ts,css,html}\" \"apps/launcher/*.{ts,json}\" \"scripts/**/*.mjs\" \"*.{js,json}\"",
    "format:check": "prettier --check \"apps/desktop/src/{main,preload,shared}/**/*.ts\" \"apps/desktop/src/renderer/src/**/*.{ts,tsx,css}\" \"apps/desktop/tests/**/*.{ts,mjs}\" \"apps/desktop/scripts/*.cjs\" \"apps/desktop/*.{ts,json}\" \"apps/launcher/src/**/*.{ts,css,html}\" \"apps/launcher/*.{ts,json}\" \"scripts/**/*.mjs\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.16"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
