{
  "name": "soul-cars-app",
  "version": "1.0.0",
  "private": true,
  "description": "SOUL Cars — Estoque e Studio em um app só (Electron + React + TypeScript + Vite)",
  "author": "Atto Comunicação",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "tipos": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "empacotar": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:engine": "cd engine && uv run --all-groups python -m unittest discover -s tests -p \"test_*.py\"",
    "smoke": "electron scripts/smoke.cjs",
    "smoke:instagram": "node scripts/preparar-smoke-instagram.cjs && electron scripts/smoke-instagram.cjs",
    "formatar": "prettier --write \"src/main/**/*.ts\" \"src/preload/**/*.ts\" \"src/compartilhado/**/*.ts\" \"src/renderer/src/**/*.{ts,tsx,css}\" \"*.{ts,json}\" \"testes/**/*.{ts,mjs}\" \"scripts/*.cjs\"",
    "formatar:check": "prettier --check \"src/main/**/*.ts\" \"src/preload/**/*.ts\" \"src/compartilhado/**/*.ts\" \"src/renderer/src/**/*.{ts,tsx,css}\" \"*.{ts,json}\" \"testes/**/*.{ts,mjs}\" \"scripts/*.cjs\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.soulcars.app",
    "productName": "SOUL Cars",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "to": "engine",
        "from": "engine",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icone.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SOUL Cars"
    }
  }
}
